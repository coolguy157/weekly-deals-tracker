# Local Configuration (Gitignored - Safe for personal info)
# Copy this file to .env and replace with your local parameters:
#   cp .env.example .env

# Single Store Default (e.g. Giant Lewisburg PA or Tom Thumb)
TRACKER_ZIP=17837
TRACKER_MERCHANT=Giant Food Stores

# Multi-Store Tracking (comma-separated list of zip:merchant pairs):
# TRACKER_STORES=17837:Giant Food Stores,75080:Tom Thumb

# Optional: Vision API keys for automated backfill parsing of raw flyer scans
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

